# Project-generated data and outputs
data/raw/*
data/processed/*
outputs/figures/*

# Processed outputs the dashboard reads are committed so the deployed app works
# without downloading data. prices.parquet (only needed by the pipeline) is not.
!data/processed/returns.parquet
!data/processed/trends.parquet
!data/processed/rolling_correlation_benchmark.parquet
!data/processed/average_pairwise_correlation.parquet
!data/processed/stock_summary.csv
!data/processed/benchmark_summary.csv
!data/processed/sector_summary.csv
!data/processed/trend_summary.csv
!data/processed/correlation_matrix.csv
!data/processed/correlation_pairs.csv
!data/processed/data_quality.csv
!data/processed/final_insights.txt

# Streamlit local secrets
.streamlit/secrets.toml

# Keep placeholder files so empty project directories are retained
!data/raw/.gitkeep
!data/processed/.gitkeep
!outputs/figures/.gitkeep
